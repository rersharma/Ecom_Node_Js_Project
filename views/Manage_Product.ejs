<%- include ('common/Admin_header.ejs') %>

<div class="container-fluid mt-5 mb-5">
     <div class="row">
          <div class="col-sm-12 mt-2">
            
            <h1 class="text-center bg-primary p-2 text-white">Manage Products</h1>
                 
                    <table class=" table table-striped table-primary">
                            <thead>
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">No of Stock</th>
                                    <th scope="col">Discount offer (%)</th>
                                    <th scope="col">Photo</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                          <% record.forEach((item)=>{%>
                                            <tr>
                                                <td> <%=item.id%> </td>
                                                 <td> <%=item.name%> </td>
                                                  <td> <%=item.type%> </td>
                                                   <td> <%=item.price%> </td>
                                                    <td> <%=item.no_stock%> </td>
                                                     <td> <%=item.discount%> </td>
                                                      <td><img src="product_photo/<%=item.photo%>" width="100" height="100" /> </td>
                                                       <td> <%=item.description%> </td>
                                                        <td> 
                                                             <a href="/delete_product/<%=item.id%>" onclick="return confirm('Are You Sure?');" class="btn btn-danger">Delete</a>
                                                             <a href="" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productmodal" onclick="set_value('<%=item.id%>','<%=item.name%>','<%=item.type%>','<%=item.price%>','<%=item.no_stock%>','<%=item.discount%>','product_photo/<%=item.photo%>','<%=item.description%>');">Update</a>
                                                        </td>
                                            </tr>
                                        
                                        <% }) %>
                            </tbody>
                    </table>
          </div>
     </div>
</div>


<!-- Modal -->
<div class="modal fade" id="productmodal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Manage Product</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        
             <form action="/update_product" method="post" enctype="multipart/form-data">
              <input type="hidden" name="pid" id="pid">
               <div class="mt-2">
                     <label for="pname">Product Name</label>
                     <input type="text" name="pname" id="pname" required class="form-control">
                 </div>

                 <div class="mt-2">
                     <label for="ptype">Product Type</label>
                     <select name="ptype" id="ptype" required class="form-control">
                        <option selected disabled value="">Select Product Type</option>
                        <option>Grocery</option>
                        <option>Electronic</option>
                        <option>Cloth</option>
                        <option>Furniture</option>
                     </select>
                 </div>

                  <div class="mt-2">
                     <label for="pprice">Product Price</label>
                     <input type="number" name="pprice" id="pprice" required class="form-control">
                 </div>

                 <div class="mt-2">
                     <label for="pstock">No of Stock Available</label>
                     <input type="number" name="pstock" id="pstock" required class="form-control">
                 </div>

                  <div class="mt-2">
                     <label for="pdiscount">Any Discount Offer(%)</label>
                     <input type="number" name="pdiscount" id="pdiscount" required class="form-control">
                 </div>

                  <div class="mt-2">
                     <label for="pphoto">Product Photo</label>
                     <input type="file" name="pphoto" id="pphoto"  class="form-control">
                     <img src="" name="myimage" id="myimage" width="40" height="40">
                 </div>

                 <div class="mt-2">
                     <label for="pdescription">Description</label>
                     <textarea name="pdescription" id="pdescription" required class="form-control"></textarea>
                 </div>

                 <div class="mt-2">
                     <input type="submit" name="button" value="Update Now"   required class="btn btn-primary">
                 </div>


             </form>
      </div>
  
    </div>
  </div>
</div>

<script>
   function set_value(id, name, type, price, stock, discount, photo, description) {
    document.getElementById("pid").value = id;
    document.getElementById("pname").value = name;
    document.getElementById("ptype").value = type;
    document.getElementById("pprice").value = price;
    document.getElementById("pstock").value = stock;
    document.getElementById("pdiscount").value = discount;
    document.getElementById("pdescription").value = description;
    document.getElementById("myimage").src = photo;
}
</script>

<%- include ('common/footer.ejs') %>