<%- include ('common/Admin_header.ejs') %>


<div class="container mt-5 mb-5">
     <div class="row">
          <div class="col-sm-12 mt-2">
            
            <h1 class="text-center bg-primary p-2 text-white">Enquiry Box </h1>

            <table class=" table table-striped table-primary">
                            <thead>
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Email-Id</th>
                                    <th scope="col">Subject</th>
                                    <th scope="col">Customer Query</th>
                                    <th scope="col">My Reply</th>
                                    <th scope="col">Admin Reply</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                         <% record.forEach((item)=>{%>
                                            <tr>
                                                <td> <%=item.id%> </td>
                                                 <td> <%=item.email%> </td>
                                                  <td> <%=item.subject%> </td>
                                                   <td> <%=item.query%> </td>
                                                    <td> <%=item.cust_reply%> </td>
                                                     <td> <%=item.admin_reply%> </td>
                                                        <td> 
                                                             <a href="/delete_tickets/<%=item.id%>" onclick="return confirm('Are You Sure?');" class="btn btn-danger">Delete</a>
                                                             <a href="" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#replymodal">Admin Reply</a>
                                                        </td>
                                            </tr>
                                        
                                        <% }) %> 
                            </tbody>
                    </table>



       </div>
     </div>
</div>


<%- include ('common/footer.ejs') %>