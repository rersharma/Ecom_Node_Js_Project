<%- include ('common/customer_header.ejs') %>

<div class="container mt-5">
     <div class="row mt-5">
        
         <div class="col-sm-12 mt-5">
            <h1 class="text-center">My Orders</h1>
            <table class="table table-bordered mt-5">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Product Type</th>
                        <th>Quantity</th>
                        <th>Product Price</th>
                        <th>Total Price</th>
                        <th>Product Photo</th>
                    </tr>
                </thead>
                <tbody>
                   
                        <% record.forEach(order => { %>
                            <tr>
                                <td><%= order.pname %></td>
                                <td><%= order.ptype %></td>
                                <td><%= order.buy_qnty %></td>
                                <td><%= order.product_price %></td>
                                <td><%= order.total_price %></td>
                                <td><img src="product_photo/<%= order.product_photo %>" alt="Product Photo" width="100"></td>
                            </tr>
                        <% }) %>
                   
                </tbody>
            </table>
         </div>

     </div>
</div>



<%- include ('common/footer.ejs') %>